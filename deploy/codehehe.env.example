# Copy this file to /etc/codehehe/codehehe.env on the Azure VM.
# Replace every <...> value. Never commit the populated production file.

DJANGO_SECRET_KEY=<generate-a-long-random-secret>
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=<codehehe-domain>
DJANGO_CSRF_TRUSTED_ORIGINS=https://<codehehe-domain>
DJANGO_DB_PATH=/var/lib/codehehe/db.sqlite3
DJANGO_STATIC_ROOT=/var/www/codehehe/static
DJANGO_SQLITE_TIMEOUT=20
DJANGO_TIME_ZONE=Asia/Ho_Chi_Minh
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_PRELOAD=False
DJANGO_LOG_LEVEL=INFO
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=<smtp-host>
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=<smtp-username>
DJANGO_EMAIL_HOST_PASSWORD=<smtp-password>
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_TIMEOUT_SECONDS=10
DJANGO_DEFAULT_FROM_EMAIL="CodeHehe <no-reply@codehehe-domain>"
PASSWORD_RESET_TIMEOUT_SECONDS=3600
EMAIL_VERIFICATION_TIMEOUT_SECONDS=300
PENDING_REGISTRATION_RETENTION_SECONDS=7200
ACCOUNT_EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600
ACCOUNT_EMAIL_RATE_LIMIT_PER_IP=10
ACCOUNT_EMAIL_RATE_LIMIT_PER_ADDRESS=3

MATCH_PENDING_SUBMISSION_TIMEOUT_SECONDS=120
MATCH_DURATION_SECONDS=300
MATCH_SUBMIT_RATE_LIMIT=30
MATCH_RUN_RATE_LIMIT=60
MATCH_RATE_LIMIT_WINDOW_SECONDS=60
MATCH_INTEGRITY_ENABLED=True
MATCH_INTEGRITY_HEARTBEAT_SECONDS=10
MATCH_INTEGRITY_IGNORE_BELOW_SECONDS=1
MATCH_INTEGRITY_STRIKE_SECONDS=3
MATCH_INTEGRITY_FLAG_STRIKES=2
MATCH_INTEGRITY_FLAG_TOTAL_SECONDS=10
MATCH_INTEGRITY_CONNECTION_GAP_SECONDS=30
MATCH_INTEGRITY_RATE_LIMIT=30
MATCH_INTEGRITY_MAX_BATCH_SIZE=20

READINESS_CHECK_JUDGE0=True
JUDGE0_BASE_URL=http://127.0.0.1:2358
JUDGE0_API_KEY=

AI_REVIEW_ENABLED=True
AI_REVIEW_PROVIDER=groq
GROQ_API_KEY=<groq-api-key>
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=https://<codehehe-domain>
OPENROUTER_APP_TITLE=CodeHehe
AI_REVIEW_MODEL=openai/gpt-oss-120b
AI_REVIEW_REASONING_EFFORT=none
AI_REVIEW_PROMPT_VERSION=v2
AI_REVIEW_MAX_OUTPUT_TOKENS=2048
AI_REVIEW_MAX_ATTEMPTS=5
AI_REVIEW_MAX_MANUAL_RETRIES=1
AI_REVIEW_REQUESTS_PER_MINUTE=15
AI_REVIEW_STALE_SECONDS=300
AI_REVIEW_MAX_SOURCE_CHARS=16000

OPERATIONS_DASHBOARD_REFRESH_SECONDS=15
OPERATIONS_DASHBOARD_HIDDEN_REFRESH_SECONDS=60
OPERATIONS_DASHBOARD_SNAPSHOT_CACHE_SECONDS=10
OPERATIONS_JUDGE_HEALTH_CACHE_SECONDS=30
OPERATIONS_JUDGE_SLOW_MS=1000
OPERATIONS_WAITING_STALE_SECONDS=1800
OPERATIONS_MATCH_GRACE_SECONDS=60
OPERATIONS_AI_QUEUE_WARNING_SECONDS=600
OPERATIONS_AI_WORKER_STALE_SECONDS=90
OPERATIONS_SWEEPER_STALE_SECONDS=60
OPERATIONS_AI_FAILURE_WINDOW_SECONDS=900
OPERATIONS_AI_FAILURE_WARNING_COUNT=3
OPERATIONS_INTEGRITY_ALERT_WINDOW_SECONDS=86400
