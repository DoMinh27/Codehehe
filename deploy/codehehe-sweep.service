[Unit]
Description=CodeHehe stale submission and match sweeper
After=network-online.target codehehe.service
Wants=network-online.target

[Service]
Type=oneshot
Group=codehehe
User=codehehe
WorkingDirectory=/opt/codehehe/app
EnvironmentFile=/etc/codehehe/codehehe.env
ExecStart=/opt/codehehe/venv/bin/python manage.py sweep_matches
TimeoutStartSec=120
UMask=0077
