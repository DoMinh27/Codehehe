[Unit]
Description=CodeHehe queued AI review processor
After=network-online.target codehehe.service
Wants=network-online.target

[Service]
Type=oneshot
Group=codehehe
User=codehehe
WorkingDirectory=/opt/codehehe/app
EnvironmentFile=/etc/codehehe/codehehe.env
ExecStart=/opt/codehehe/venv/bin/python manage.py process_ai_reviews --limit 1
TimeoutStartSec=120
UMask=0077
